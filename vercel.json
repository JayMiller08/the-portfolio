{
    "headers": [
        {
            "source": "/downloads/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/blank-file",
            "destination": "/blank-file.html"
        },
        {
            "source": "/blank-file/",
            "destination": "/blank-file.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
