# Frontend environment variables.
#
# Everything prefixed with VITE_ is compiled into the JavaScript bundle and is
# publicly readable by anyone who visits the site. Only put publishable values
# here. The Paystack SECRET key must never appear in this file — it is set as a
# Supabase Edge Function secret instead (see docs/PAYSTACK_SETUP.md).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
